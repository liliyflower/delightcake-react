rules_version = '2';

// Copy these into Firebase Console -> Firestore Database -> Rules,
// or deploy with the Firebase CLI (firebase deploy --only firestore:rules).
//
// - cakes:    anyone can read the catalog; only edited by you (console/admin SDK).
// - orders:   anyone can create an order; nobody can read, edit, or list
//             other people's orders from the client (do that from the
//             Firebase console or a trusted backend/Cloud Function).
// - messages: same idea as orders, for the contact form.
service cloud.firestore {
  match /databases/{database}/documents {

    match /cakes/{cakeId} {
      allow read: if true;
      allow write: if false;
    }

    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
